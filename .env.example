APP_ENV=dev
APP_DEBUG=true

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mech_library
DB_USER=mech_library
DB_PASS=

# MUL crawler
MUL_BASE_URL=http://masterunitlist.info
MUL_REQUEST_DELAY_MS=1000
MUL_USER_AGENT="MechLibrary/0.1 (private use; see README)"
MUL_RAW_CACHE_DIR=data/raw

# Mattermost OAuth (login + channel-based army visibility)
MM_BASE_URL=https://mm.freisicht.net
MM_OAUTH_CLIENT_ID=
MM_OAUTH_CLIENT_SECRET=
MM_OAUTH_REDIRECT_URI=https://mechlib.hyperhabitat.de/auth/callback
