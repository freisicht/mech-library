APP_ENV=dev
APP_DEBUG=true

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mech_library
DB_USER=mech_library
DB_PASS=

# MUL crawler
MUL_BASE_URL=https://masterunitlist.battletech.com
# robots.txt asks for 10 s; lower values are raised to that
MUL_REQUEST_DELAY_MS=10000
MUL_USER_AGENT="MechLibrary/0.2 (private use; https://github.com/freisicht/mech-library)"
MUL_RAW_CACHE_DIR=data/raw

# Login, see docs/AUTH.md
#   local:      accounts managed with bin/console user:add (no external service)
#   discord:    members of the Discord servers listed below
#   mattermost: OAuth2 against a Mattermost server, configured below
AUTH_PROVIDER=local

# Discord OAuth, only used with AUTH_PROVIDER=discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://mechlib.example.com/auth/callback
# Comma-separated server IDs; only their members can log in
DISCORD_ALLOWED_GUILDS=

# Mattermost OAuth, only used with AUTH_PROVIDER=mattermost
MM_BASE_URL=
MM_OAUTH_CLIENT_ID=
MM_OAUTH_CLIENT_SECRET=
MM_OAUTH_REDIRECT_URI=https://mechlib.example.com/auth/callback
