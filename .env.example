APP_ENV=dev
APP_DEBUG=true

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mech_library
DB_USER=mech_library
DB_PASS=

# MUL crawler
MUL_BASE_URL=https://masterunitlist.info
MUL_REQUEST_DELAY_MS=1000
MUL_USER_AGENT="MechLibrary/0.1 (private use; see README)"
MUL_RAW_CACHE_DIR=data/raw

# Login, see docs/AUTH.md
#   local:      accounts managed with bin/console user:add (no external service)
#   mattermost: OAuth2 against a Mattermost server, configured below
AUTH_PROVIDER=local

# Mattermost OAuth, only used with AUTH_PROVIDER=mattermost
MM_BASE_URL=
MM_OAUTH_CLIENT_ID=
MM_OAUTH_CLIENT_SECRET=
MM_OAUTH_REDIRECT_URI=https://mechlib.example.com/auth/callback
