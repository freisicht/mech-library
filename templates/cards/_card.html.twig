{# One Alpha Strike card. Sized via parent grid cell (2x2 on A4). #}
{% set armor = unit.armor ?? 0 %}
{% set struc = unit.bf_structure ?? 0 %}
<table class="as-card" cellspacing="0" cellpadding="0">
    <tr>
        <td class="as-name-cell">
            <div class="as-title">{{ unit.name }}</div>
            {% if unit.variant %}<div class="as-variant">{{ unit.variant }}</div>{% endif %}
        </td>
        <td class="as-pv-cell">
            <div class="as-pv-label">PV</div>
            <div class="as-pv-val">{{ unit.pv ?? '—' }}</div>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="as-meta-cell">
            <b>TP</b> {{ unit.bf_type ?? '—' }} &nbsp;
            <b>SZ</b> {{ unit.bf_size ?? '—' }} &nbsp;
            <b>MV</b> {{ unit.bf_move ?? '—' }} &nbsp;
            <b>Role</b> {{ unit.role ?? '—' }} &nbsp;
            <b>Skill</b> {{ skill }}
        </td>
    </tr>
    <tr>
        <td colspan="2" class="as-stats-cell">
            <table class="as-stats" cellspacing="0" cellpadding="0">
                <tr class="as-stats-head">
                    <td>S (+0)</td><td>M (+2)</td><td>L (+4)</td><td>E (+6)</td><td>OV</td><td>TMM</td>
                </tr>
                <tr class="as-stats-row">
                    <td>{{ unit.dmg_s is null ? '—' : (unit.dmg_s ~ (unit.bf_damage_short_min ? '*' : '')) }}</td>
                    <td>{{ unit.dmg_m is null ? '—' : (unit.dmg_m ~ (unit.bf_damage_medium_min ? '*' : '')) }}</td>
                    <td>{{ unit.dmg_l is null ? '—' : (unit.dmg_l ~ (unit.bf_damage_long_min ? '*' : '')) }}</td>
                    <td>{{ unit.bf_damage_extreme is null ? '—' : (unit.bf_damage_extreme ~ (unit.bf_damage_extreme_min ? '*' : '')) }}</td>
                    <td>{{ unit.bf_overheat ?? '—' }}</td>
                    <td>{{ unit.tmm ?? '—' }}</td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="as-bars-cell">
            <div class="as-bar">
                <b>Armor</b>
                <span class="as-pip-row">{% if armor > 0 %}{% for i in 1..armor %}&#9633;{% endfor %}{% endif %}</span>
                <span class="as-bar-num">({{ armor }})</span>
            </div>
            <div class="as-bar">
                <b>Struct</b>
                <span class="as-pip-row">{% if struc > 0 %}{% for i in 1..struc %}&#9632;{% endfor %}{% endif %}</span>
                <span class="as-bar-num">({{ struc }})</span>
            </div>
            {% if unit.bf_threshold %}
                <div class="as-bar"><b>Threshold</b> <span class="as-bar-num">{{ unit.bf_threshold }}</span></div>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td colspan="2" class="as-specials-cell">
            <b>Specials:</b> {{ unit.bf_abilities ?: '—' }}
        </td>
    </tr>
    <tr>
        <td class="as-foot-cell">{{ unit.tonnage }}t · {{ unit.class }}</td>
        <td class="as-foot-cell as-foot-right">MUL #{{ unit.mul_id ?? '' }}</td>
    </tr>
</table>
