{# One Alpha Strike card. Sized via parent grid cell (3x2 on A4). #}
{% set armor   = unit.armor ?? 0 %}
{% set struc   = unit.bf_structure ?? 0 %}
{% set hasE    = (unit.bf_damage_extreme ?? 0) > 0 %}
{% set ov      = unit.bf_overheat ?? 0 %}
<table class="as-card" cellspacing="0" cellpadding="0">
    <tr>
        <td class="as-name-cell">
            <div class="as-title">{{ unit.name }}</div>
        </td>
        <td class="as-pv-cell">{{ unit.pv ?? '—' }}</td>
    </tr>
    <tr>
        <td colspan="2" class="as-meta-cell">
            <b>TP</b> {{ unit.bf_type ?? '—' }} &nbsp;
            <b>SZ</b> {{ unit.bf_size ?? '—' }} &nbsp;
            <b>MV</b> {{ unit.bf_move ?? '—' }} &nbsp;
            <b>Skill</b> {{ skill }} &nbsp;
            <b>TMM</b> {{ unit.tmm ?? '—' }}
        </td>
    </tr>
    <tr>
        <td colspan="2" class="as-stats-cell">
            <span class="as-dmg-label">DMG</span>
            <span class="as-dmg"><b>S</b> {{ unit.dmg_s ?? 0 }}{{ unit.bf_damage_short_min ? '*' : '' }}</span>
            <span class="as-dmg"><b>M</b> {{ unit.dmg_m ?? 0 }}{{ unit.bf_damage_medium_min ? '*' : '' }}</span>
            <span class="as-dmg"><b>L</b> {{ unit.dmg_l ?? 0 }}{{ unit.bf_damage_long_min ? '*' : '' }}</span>
            {% if hasE %}<span class="as-dmg"><b>E</b> {{ unit.bf_damage_extreme }}{{ unit.bf_damage_extreme_min ? '*' : '' }}</span>{% endif %}
        </td>
    </tr>
    <tr>
        <td colspan="2" class="as-heat-cell">
            <b>OV</b> {{ ov }} &nbsp;|&nbsp;
            <b>Heat</b>
            {% if ov > 0 %}{% for i in 1..ov %}&#9744;{{ i }} {% endfor %}{% endif %}&#9744;S
        </td>
    </tr>
    <tr>
        <td colspan="2" class="as-bars-cell">
            <div class="as-bar">
                <b>A</b>
                <span class="as-pip-row as-pip-armor">{% if armor > 0 %}{% for i in 1..armor %}&#9633;{% endfor %}{% endif %}</span>
                <span class="as-bar-num">({{ armor }})</span>
            </div>
            <div class="as-bar">
                <b>S</b>
                <span class="as-pip-row as-pip-struct">{% if struc > 0 %}{% for i in 1..struc %}&#9632;{% endfor %}{% endif %}</span>
                <span class="as-bar-num">({{ struc }})</span>
            </div>
            {% if unit.bf_threshold %}
                <div class="as-bar"><b>TH</b> <span class="as-bar-num">{{ unit.bf_threshold }}</span></div>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td colspan="2" class="as-crit-cell">
            <b>Crits</b><br>
            <span class="as-crit"><i>Engine</i> &#9744; <span class="as-crit-eff">+1 Heat</span></span><br>
            <span class="as-crit"><i>Fire Ctrl</i> &#9744;&#9744;&#9744;&#9744; <span class="as-crit-eff">+2 To-Hit ea.</span></span><br>
            <span class="as-crit"><i>MP</i> &#9744;&#9744;&#9744;&#9744; <span class="as-crit-eff">&frac12; MV ea.</span></span><br>
            <span class="as-crit"><i>Weapons</i> &#9744;&#9744;&#9744;&#9744; <span class="as-crit-eff">-1 Dmg ea.</span></span>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="as-specials-cell">
            <b>Specials:</b> {{ unit.bf_abilities ?: '—' }}
        </td>
    </tr>
    <tr>
        <td class="as-foot-cell">{{ unit.tonnage }}t · {{ unit.class }}{% if unit.role %} · {{ unit.role }}{% endif %}</td>
        <td class="as-foot-cell as-foot-right">MUL #{{ unit.mul_id ?? '' }}</td>
    </tr>
</table>
