<!doctype html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Mech Library{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/pico.min.css">
    <link rel="stylesheet" href="/assets/css/tabulator.min.css">
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body class="with-force-panel">
    <header class="container-fluid">
        <nav>
            <ul>
                <li><strong><a href="/">⚙ Mech Library</a></strong></li>
            </ul>
        </nav>
    </header>

    <div class="app-layout">
        <main class="container-fluid app-main">
            {% block content %}{% endblock %}
        </main>

        {% include '_force_panel.html.twig' %}
    </div>

    <script src="/assets/js/tabulator.min.js"></script>
    <script src="/assets/js/force.js"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
