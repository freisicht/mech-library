{% extends 'base.html.twig' %}
{% block title %}Units — Mech Library{% endblock %}

{% block content %}

{# ── Filter bar ── #}
<div class="filter-wrap">
<form id="filter-form" class="filter-bar" method="get" action="/">

    <div class="filter-bar-row">

        <label class="fgrp fgrp-search">
            <span class="fgrp-pfx" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></span>
            <input type="search" id="search" name="search" placeholder="Unit name"
                   aria-label="Search" value="{{ params.search ?? '' }}">
        </label>

        <label class="fgrp">
            <span class="fgrp-pfx">Type</span>
            <select id="type" name="type">
                <option value="">All</option>
                {% for t in options.types %}
                    <option value="{{ t.id }}"
                        {% if (params.type ?? '')~ '' == t.id~ '' %}selected{% endif %}>
                        {{ t.name }}
                    </option>
                {% endfor %}
            </select>
        </label>

        <div class="fgrp" role="group" aria-label="PV range">
            <span class="fgrp-pfx">PV</span>
            <input type="number" name="pv_min" placeholder="min" min="0" aria-label="PV min"
                   value="{{ params.pv_min ?? '' }}">
            <span class="fgrp-dash">–</span>
            <input type="number" name="pv_max" placeholder="max" min="0" aria-label="PV max"
                   value="{{ params.pv_max ?? '' }}">
        </div>

        <div class="fgrp" role="group" aria-label="Move range in inches">
            <span class="fgrp-pfx">Move</span>
            <input type="number" name="move_min" placeholder="min" min="0" aria-label="Move min"
                   value="{{ params.move_min ?? '' }}">
            <span class="fgrp-dash">–</span>
            <input type="number" name="move_max" placeholder="max" min="0" aria-label="Move max"
                   value="{{ params.move_max ?? '' }}">
            <label class="fgrp-check">
                <input type="checkbox" name="jump" value="1"
                    {% if params.jump ?? false %}checked{% endif %}>
                jump
            </label>
        </div>

        <div class="filter-bar-actions">
        <button type="button" id="filter-more-btn" class="filter-more-btn"
                aria-expanded="false" aria-controls="filter-more">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
            More filters
            <span class="filter-more-count" id="filter-more-count" hidden></span>
        </button>

        <button type="submit" class="btn-primary filter-apply">Apply</button>
        </div>

    </div>

    <div class="filter-chips" id="filter-chips" hidden>
        <span class="filter-chips-label">Active</span>
        <span id="filter-chips-list" class="filter-chips-list"></span>
        <a href="/" class="filter-clear">Clear all</a>
    </div>

    <div class="filter-more" id="filter-more" hidden>

        <div class="filter-more-stats">
            <p class="filter-sec">Combat</p>
            <div class="fstat" data-chip-label="TMM">
                <span class="fstat-lbl">TMM ≥</span>
                <div class="fgrp fgrp-sm">
                    <input type="number" id="tmm_min" name="tmm_min" placeholder="min" aria-label="TMM min"
                           value="{{ params.tmm_min ?? '' }}">
                </div>
            </div>
            {% for key, lbl in {s: 'Dmg S', m: 'Dmg M', l: 'Dmg L'} %}
            <div class="fstat" data-chip-label="{{ lbl }}">
                <span class="fstat-lbl">{{ lbl }}</span>
                <div class="fgrp fgrp-sm" role="group" aria-label="{{ lbl }}">
                    <input type="number" name="{{ key }}_min" placeholder="min" min="0" aria-label="{{ lbl }} min"
                           value="{{ attribute(params, key ~ '_min') ?? '' }}">
                    <span class="fgrp-dash">–</span>
                    <input type="number" name="{{ key }}_max" placeholder="max" min="0" aria-label="{{ lbl }} max"
                           value="{{ attribute(params, key ~ '_max') ?? '' }}">
                </div>
            </div>
            {% endfor %}
            <div class="fstat" data-chip-label="Year">
                <span class="fstat-lbl">Year</span>
                <div class="fgrp fgrp-sm" role="group" aria-label="Intro year">
                    <input type="number" name="year_min" placeholder="from" min="2000" max="3200" aria-label="Year from"
                           value="{{ params.year_min ?? '' }}">
                    <span class="fgrp-dash">–</span>
                    <input type="number" name="year_max" placeholder="to" min="2000" max="3200" aria-label="Year to"
                           value="{{ params.year_max ?? '' }}">
                </div>
            </div>
        </div>

        <div class="filter-more-sets">
            <fieldset class="filter-set" data-chip-label="Role">
                <legend class="filter-sec">Role</legend>
                <div class="pills">
                    {% for r in options.roles %}
                        <label class="pill"><input type="checkbox" name="role[]" value="{{ r.id }}"
                            {% if r.id~ '' in (params.role ?? []) %}checked{% endif %}>{{ r.name }}</label>
                    {% endfor %}
                </div>
            </fieldset>

            <div class="filter-set-row">
                <fieldset class="filter-set" data-chip-label="Tech">
                    <legend class="filter-sec">Tech Base</legend>
                    <div class="pills">
                        {% for t in options.technologies %}
                            <label class="pill"><input type="checkbox" name="tech[]" value="{{ t.id }}"
                                {% if t.id~ '' in (params.tech ?? []) %}checked{% endif %}>{{ t.name }}</label>
                        {% endfor %}
                    </div>
                </fieldset>

                <fieldset class="filter-set" data-chip-label="Era">
                    <legend class="filter-sec">Era</legend>
                    <div class="pills">
                        {% for e in options.eras %}
                            <label class="pill"{% if e.start_year %} title="from {{ e.start_year }}"{% endif %}><input type="checkbox" name="era[]" value="{{ e.id }}"
                                {% if e.id~ '' in (params.era ?? []) %}checked{% endif %}>{{ e.name }}</label>
                        {% endfor %}
                    </div>
                </fieldset>
            </div>

            <div class="filter-set">
                <p class="filter-sec">Abilities</p>
                <div class="ability-builder">
                    <div class="fgrp fgrp-sm">
                        <select id="ability-tag-select" aria-label="Ability tag">
                            <option value="">pick tag</option>
                            {% for tag in options.abilityTags %}
                                <option value="{{ tag }}">{{ tag }}</option>
                            {% endfor %}
                        </select>
                        <input type="number" id="ability-val-input" placeholder="≥" min="0"
                               aria-label="Minimum value" class="fgrp-num">
                    </div>
                    <button type="button" id="ability-add-btn" class="pill pill-btn">+ Add</button>
                    <span id="ability-chips" class="ability-chips"></span>
                    <div class="seg" role="radiogroup" aria-label="Match mode">
                        <label><input type="radio" name="ability_mode" value="and"
                               {% if (params.ability_mode ?? 'and') == 'and' %}checked{% endif %}>All</label>
                        <label><input type="radio" name="ability_mode" value="or"
                               {% if (params.ability_mode ?? 'and') == 'or' %}checked{% endif %}>Any</label>
                    </div>
                </div>
                <div id="ability-inputs">
                    {% for ab in (params.ability ?? []) %}
                        <input type="hidden" name="ability[]" value="{{ ab }}">
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="filter-more-foot">
            <a href="/" class="filter-clear">Reset all</a>
            <button type="submit" class="btn-primary">Apply</button>
        </div>

    </div>

</form>
</div>

{# Hidden result count — value is set by app.js, displayed in status bar #}
<div id="result-count" aria-live="polite" hidden></div>

{# Unit table (Tabulator mounts here) #}
<div id="unit-table"></div>

{# Status bar #}
<div class="status-bar">
    <span class="status-bar-label">UNITS:</span>
    <span class="status-bar-count" id="status-unit-count">—</span>
    <span class="status-bar-sep">|</span>
    <span class="status-bar-hint">Click name for detail · [+] adds to formation</span>
</div>

{% endblock %}

{% block scripts %}
<script>
    window.ML = window.ML || {};
    window.ML.apiUrl = '/api/units';
    window.ML.initialParams = {{ params|json_encode|raw }};
</script>
<script src="/assets/js/app.js"></script>
<script>
(function () {
    // Mirror result-count into status bar counter
    var rc = document.getElementById('result-count');
    var sc = document.getElementById('status-unit-count');
    if (rc && sc) {
        var obs = new MutationObserver(function () {
            sc.textContent = rc.textContent;
        });
        obs.observe(rc, { childList: true, subtree: true, characterData: true });
    }
})();
</script>
{% endblock %}
