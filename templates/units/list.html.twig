{% extends 'base.html.twig' %}
{% block title %}Units — Mech Library{% endblock %}

{% block content %}

{# ── Filter Matrix panel ── #}
<div class="filter-wrap">
<div class="filter-panel" id="filter-panel">
    <div class="corner-tl" style="width:10px;height:10px;"></div>

    {# Collapsible header #}
    <div class="filter-panel-header" id="filter-panel-header">
        <span class="filter-panel-label">Filter Matrix</span>
        <span class="filter-panel-chevron open" id="filter-panel-chevron">▶</span>
    </div>

    {# Panel body #}
    <div class="filter-panel-body" id="filter-panel-body">

    <form id="filter-form" method="get" action="/">

        {# Row 1: Search / Type / PV / Move #}
        <div class="filter-grid">

            <div class="filter-cell">
                <label for="search">Search</label>
                <input type="text" id="search" name="search"
                       placeholder="Name / Class / Variant"
                       value="{{ params.search ?? '' }}">
            </div>

            <div class="filter-cell">
                <label for="type">Type</label>
                <div class="select-wrap">
                <select id="type" name="type">
                    <option value="">All types</option>
                    {% for t in options.types %}
                        <option value="{{ t.id }}"
                            {% if (params.type ?? '')~ '' == t.id~ '' %}selected{% endif %}>
                            {{ t.name }}
                        </option>
                    {% endfor %}
                </select>
                </div>
            </div>

            <div class="filter-cell filter-range">
                <label>PV</label>
                <div class="range-inputs">
                    <input type="number" name="pv_min" placeholder="min" min="0"
                           value="{{ params.pv_min ?? '' }}">
                    <span class="range-sep">—</span>
                    <input type="number" name="pv_max" placeholder="max" min="0"
                           value="{{ params.pv_max ?? '' }}">
                </div>
            </div>

            <div class="filter-cell filter-range">
                <label>Move (inches)</label>
                <div class="range-inputs">
                    <input type="number" name="move_min" placeholder="min" min="0"
                           value="{{ params.move_min ?? '' }}">
                    <span class="range-sep">—</span>
                    <input type="number" name="move_max" placeholder="max" min="0"
                           value="{{ params.move_max ?? '' }}">
                </div>
                <label class="jump-label">
                    <input type="checkbox" name="jump" value="1"
                           {% if params.jump ?? false %}checked{% endif %}>
                    Jump only
                </label>
            </div>

        </div>{# /.filter-grid #}

        {# Row 2: TMM / Damage S / M / L #}
        <div class="filter-grid-row2">

            <div class="filter-cell">
                <label for="tmm_min">TMM ≥</label>
                <input type="number" id="tmm_min" name="tmm_min" placeholder="min"
                       value="{{ params.tmm_min ?? '' }}">
            </div>

            <div class="filter-cell filter-range">
                <label>Damage S</label>
                <div class="range-inputs">
                    <input type="number" name="s_min" placeholder="min" min="0"
                           value="{{ params.s_min ?? '' }}">
                    <span class="range-sep">—</span>
                    <input type="number" name="s_max" placeholder="max" min="0"
                           value="{{ params.s_max ?? '' }}">
                </div>
            </div>

            <div class="filter-cell filter-range">
                <label>Damage M</label>
                <div class="range-inputs">
                    <input type="number" name="m_min" placeholder="min" min="0"
                           value="{{ params.m_min ?? '' }}">
                    <span class="range-sep">—</span>
                    <input type="number" name="m_max" placeholder="max" min="0"
                           value="{{ params.m_max ?? '' }}">
                </div>
            </div>

            <div class="filter-cell filter-range">
                <label>Damage L</label>
                <div class="range-inputs">
                    <input type="number" name="l_min" placeholder="min" min="0"
                           value="{{ params.l_min ?? '' }}">
                    <span class="range-sep">—</span>
                    <input type="number" name="l_max" placeholder="max" min="0"
                           value="{{ params.l_max ?? '' }}">
                </div>
            </div>

        </div>{# /.filter-grid-row2 #}

        {# Row 3: Role / Tech / Era / Year #}
        <div class="filter-grid-row3">

            <div class="filter-cell">
                <label for="role">Role</label>
                <select id="role" name="role[]" multiple>
                    {% for r in options.roles %}
                        <option value="{{ r.id }}"
                            {% if r.id~ '' in (params.role ?? []) %}selected{% endif %}>
                            {{ r.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-cell">
                <label for="tech">Tech Base</label>
                <select id="tech" name="tech[]" multiple>
                    {% for t in options.technologies %}
                        <option value="{{ t.id }}"
                            {% if t.id~ '' in (params.tech ?? []) %}selected{% endif %}>
                            {{ t.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-cell">
                <label for="era">Era</label>
                <div class="select-wrap">
                <select id="era" name="era">
                    <option value="">All eras</option>
                    {% for e in options.eras %}
                        <option value="{{ e.id }}"
                            {% if (params.era ?? '')~ '' == e.id~ '' %}selected{% endif %}>
                            {{ e.name }}{% if e.start_year %} ({{ e.start_year }}){% endif %}
                        </option>
                    {% endfor %}
                </select>
                </div>
            </div>

            <div class="filter-cell filter-range">
                <label>Intro Year</label>
                <div class="range-inputs">
                    <input type="number" name="year_min" placeholder="from" min="2000" max="3200"
                           value="{{ params.year_min ?? '' }}">
                    <span class="range-sep">—</span>
                    <input type="number" name="year_max" placeholder="to" min="2000" max="3200"
                           value="{{ params.year_max ?? '' }}">
                </div>
            </div>

        </div>{# /.filter-grid-row3 #}

        {# Row 4: Abilities + actions #}
        <div class="filter-abilities-row">

            <div class="filter-cell" style="flex:1;min-width:200px;">
                <label>Abilities / Tags</label>
                <div class="ability-builder">
                    <select id="ability-tag-select" style="width:auto;min-width:120px;">
                        <option value="">— pick tag —</option>
                        {% for tag in options.abilityTags %}
                            <option value="{{ tag }}">{{ tag }}</option>
                        {% endfor %}
                    </select>
                    <input type="number" id="ability-val-input" placeholder="≥ val" min="0"
                           style="width:70px;">
                    <div class="ability-mode-group">
                        <span class="ability-mode-label">MODE:</span>
                        <label>
                            <input type="radio" name="ability_mode" value="and"
                                   {% if (params.ability_mode ?? 'and') == 'and' %}checked{% endif %}> AND
                        </label>
                        <label>
                            <input type="radio" name="ability_mode" value="or"
                                   {% if (params.ability_mode ?? 'and') == 'or' %}checked{% endif %}> OR
                        </label>
                    </div>
                    <button type="button" id="ability-add-btn" class="btn-secondary btn-sm">+ Add</button>
                </div>
                <div id="ability-chips" class="ability-chips"></div>
                <div id="ability-inputs">
                    {% for ab in (params.ability ?? []) %}
                        <input type="hidden" name="ability[]" value="{{ ab }}">
                    {% endfor %}
                </div>
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn-primary">Apply</button>
                <a href="/" class="btn-secondary" style="clip-path:polygon(5px 0,100% 0,100% calc(100% - 5px),calc(100% - 5px) 100%,0 100%,0 5px);padding:5px 14px;font-family:'Orbitron',monospace;font-size:10px;font-weight:700;letter-spacing:0.10em;border:1px solid var(--border);color:var(--text-dim);text-decoration:none;display:inline-block;transition:all 0.12s;">Reset</a>
            </div>

        </div>{# /.filter-abilities-row #}

    </form>

    </div>{# /.filter-panel-body #}
</div>{# /.filter-panel #}
</div>{# /.filter-wrap #}

{# Hidden result count — value is set by app.js, displayed in status bar #}
<div id="result-count" aria-live="polite" hidden></div>

{# Unit table (Tabulator mounts here) #}
<div id="unit-table"></div>

{# Status bar #}
<div class="status-bar">
    <span class="status-bar-label">UNITS:</span>
    <span class="status-bar-count" id="status-unit-count">—</span>
    <span class="status-bar-sep">|</span>
    <span class="status-bar-hint">Click name for detail · [+] adds to formation</span>
</div>

{% endblock %}

{% block scripts %}
<script>
    window.ML = window.ML || {};
    window.ML.apiUrl = '/api/units';
    window.ML.initialParams = {{ params|json_encode|raw }};
</script>
<script src="/assets/js/app.js"></script>
<script>
(function () {
    // Mirror result-count into status bar counter
    var rc = document.getElementById('result-count');
    var sc = document.getElementById('status-unit-count');
    if (rc && sc) {
        var obs = new MutationObserver(function () {
            sc.textContent = rc.textContent;
        });
        obs.observe(rc, { childList: true, subtree: true, characterData: true });
    }

    // Filter panel collapse toggle
    var header   = document.getElementById('filter-panel-header');
    var body     = document.getElementById('filter-panel-body');
    var chevron  = document.getElementById('filter-panel-chevron');
    if (header && body) {
        header.addEventListener('click', function () {
            var collapsed = body.style.display === 'none';
            body.style.display = collapsed ? '' : 'none';
            if (chevron) {
                chevron.classList.toggle('open', collapsed);
            }
            header.classList.toggle('collapsed', !collapsed);
        });
    }
})();
</script>
{% endblock %}
